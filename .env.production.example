# ==============================================================================
# SentiMind Production Environment Template
# ==============================================================================
# Copy this file to .env and configure with your production credentials.
# For Docker deployments, these variables are consumed by docker-compose.yml.

################################################################################
# 1. Unified Backend Service (Port 8000)
################################################################################
PORT=8000
NODE_ENV=production

# PostgreSQL Database (Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/brand_auth_db"
POSTGRES_PASSWORD=YOUR_PASSWORD

# MongoDB Atlas (Mentions & Agents Storage)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/sentimind_collector?retryWrites=true&w=majority"

# JWT Authentication
JWT_SECRET=generate-a-secure-random-64-character-secret-key-here
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRY_DAYS=7

# CORS Allowed Origins
CORS_ORIGINS=https://yourdomain.com,http://localhost:3000

# Downstream Microservices Routing
COLLECTOR_SERVICE_URL=http://collector-service:8021
SENTIMENT_SERVICE_URL=http://sentiment-service:8030

################################################################################
# 2. Razorpay Live / Test Integration
################################################################################
# Obtain from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_key_here
RAZORPAY_SIMULATION_MODE=false

################################################################################
# 3. Google Gemini AI Engine
################################################################################
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

################################################################################
# 4. Message Broker & Distributed Tasks (Celery & RabbitMQ)
################################################################################
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=rpc://

################################################################################
# 5. Autonomous Agent Policy & Safety Guardrails
################################################################################
MAX_AGENT_ACTIONS_PER_DAY=50
MAX_DISCOUNT_PERCENT=25
MAX_CAMPAIGN_BUDGET=5000000
REQUIRE_APPROVAL_ABOVE_AMOUNT=100000
MIN_CREDIBILITY_SCORE=0.4
BASELINE_HOURS=168
WINDOW_HOURS=6
SPIKE_DEVIATION_THRESHOLD=1.5
SPIKE_MIN_MENTIONS=2

################################################################################
# 6. Social Media & News API Keys (Collector Service)
################################################################################
# Twitter / X (TwitterAPI.io or official v2)
TWITTER_API_KEY=
TWITTER_BEARER_TOKEN=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# Reddit OAuth API
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=SentiMind/1.0

# YouTube Data API v3
YOUTUBE_API_KEY=

# News APIs
NEWSAPI_KEY=
GNEWS_API_KEY=
NEWSDATA_API_KEY=

# Google Custom Search (Optional)
GOOGLE_API_KEY=
GOOGLE_SEARCH_CX=

################################################################################
# 7. Frontend Configuration (Vite Build Argument)
################################################################################
# Set to your public domain or API gateway proxy:
VITE_API_GATEWAY_URL=http://localhost:8000
